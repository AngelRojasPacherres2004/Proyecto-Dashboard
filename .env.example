# Copia estas variables en Netlify > Site configuration > Environment variables.
# Nunca uses el prefijo VITE_ para secretos.
DATABASE_URL=postgresql://usuario:clave@host:5432/base_de_datos
JWT_SECRET=genera-un-secreto-largo-y-aleatorio

# Obligatoria en producción: cifra nuevas credenciales SUNAT/AFP/BN.
# Debe ser una clave de 64 caracteres hexadecimales (32 bytes).
CREDENTIALS_ENCRYPTION_KEY=
